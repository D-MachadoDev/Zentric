# Zentric — ejemplo de entorno. Copiar a .env y completar secretos. Nunca commitear .env real.
# Uso: cp .env.example .env

# Postgres (compose service db). REQUIRED: sin valor por defecto.
POSTGRES_PASSWORD=change-me-32-chars-min
POSTGRES_PORT=15432
POSTGRES_DB=ZentricDb
POSTGRES_USER=postgres

# API (.NET)
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=ZentricDb;Username=postgres;Password=${POSTGRES_PASSWORD}
Jwt__Issuer=zentric-api
Jwt__Audience=zentric-client

# REQUIRED (sin valor por defecto): clave de firma JWT, minimo 256 bits.
# Generar con: openssl rand -base64 48
# docker-compose.yml interpola JWT_SIGNING_KEY; docker-compose.prod.yml y dotnet run leen Jwt__SigningKey.
JWT_SIGNING_KEY=change-me-256-bits-min
Jwt__SigningKey=change-me-256-bits-min

# REQUIRED (sin valor por defecto): contrasena del primer Administrador (alta inicial).
# Usar una sola vez y retirar la variable cuando el Administrador ya exista.
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# CORS prod: lista exacta, sin comodin
Cors__AllowedOrigins=https://zentric.me

# Resend / Email transaccional
RESEND_API_KEY=
RESEND_FROM_EMAIL=Zentric <onboarding@resend.dev>

# URLs de integración
FRONTEND_URL=http://localhost:15434
ZENTRIC_API_BASE_URL=http://localhost:15433


# Frontend (Vite)
VITE_PORT=15434
VITE_PREVIEW_PORT=15435
VITE_API_BASE_URL=http://localhost:15433
VITE_PROXY_TARGET=http://localhost:15433

# Frontend (nginx runtime)
FRONTEND_PORT=5180

# Pagos (hoy simulado). Para pasarela real definir proveedor y clave
PAYMENTS_PROVIDER=simulated
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=
