# Zentric — ejemplo de entorno. Copiar a .env y completar secretos. Nunca commitear .env real.
# Uso: cp .env.example .env

# Postgres (compose service db)
POSTGRES_PASSWORD=change-me-32-chars-min
POSTGRES_PORT=15432
POSTGRES_DB=ZentricDb
POSTGRES_USER=postgres

# API (.NET)
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=ZentricDb;Username=postgres;Password=${POSTGRES_PASSWORD}
Jwt__Issuer=zentric-api
Jwt__Audience=zentric-client
# 256 bits minimo en base64 o texto largo. Generar con: openssl rand -base64 48
Jwt__SigningKey=REEMPLAZAR-CON-SECRETO-DE-256-BITS-MINIMO

# Bootstrap admin: solo primer arranque, retirar despues de crear Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@tu-dominio.com
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR-PASSWORD-INICIAL-SEGURO

# CORS prod: lista exacta, sin comodin
Cors__AllowedOrigins=https://app.tu-dominio.com

# Frontend (nginx runtime)
FRONTEND_PORT=5180
ZENTRIC_API_BASE_URL=https://api.tu-dominio.com

# Pagos (Q-08: hoy simulado). Para pasarela real definir proveedor y clave, ver backendSDD SDD.md
PAYMENTS_PROVIDER=simulated
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=
