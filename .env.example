# Configuracion de la API .NET
# ConnectionString usada SOLO en desarrollo. En produccion se inyecta por variable de entorno.

# Host de la base de datos
# - Desde el host:      localhost
# - Desde Docker:       db  (nombre del servicio en docker-compose.yml)
ZENTRIC_DB_HOST=localhost
ZENTRIC_DB_PORT=5432
ZENTRIC_DB_NAME=ZentricDb
ZENTRIC_DB_USER=postgres

# Contrasena de desarrollo. En produccion usar un gestor de secretos.
ZENTRIC_DB_PASSWORD=postgres

# Cadena completa equivalente (usada por ASP.NET Core)
ZENTRIC_CONNECTION_STRING="Host=localhost;Port=5432;Database=ZentricDb;Username=postgres;Password=postgres"

# URLs de la API
ZENTRIC_API_URL=http://localhost:5076
ZENTRIC_SWAGGER_URL=http://localhost:5076/swagger