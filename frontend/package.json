{
  "name": "@zentric/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Consola operativa Zentric (Vite + React 19 + TanStack Router)",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite --port 15434",
    "dev:docker": "vite --host 0.0.0.0 --port 15435",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 15435",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist node_modules/.vite",
    "audit:design": "node scripts/audit-design-system.cjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "lighthouse:server": "lhci autorun --server.port=15434",
    "brandkit:generate": "node scripts/generate-brandkit.cjs",
    "brandkit:rasterize": "node scripts/rasterize-brandkit.cjs",
    "quality:gate": "pnpm run typecheck && pnpm run test:run && pnpm run audit:design"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "^4.14.0",
    "chromatic": "^18.13.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.13.0",
    "jsdom": "30.1.2",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vitest-browser-react": "^2.3.0"
  }
}
