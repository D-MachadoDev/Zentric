{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "pnpm preview",
      "startServerReadyPattern": "Local:",
      "url": [
        "http://localhost:15435/login",
        "http://localhost:15435/terms",
        "http://localhost:15435/legal"
      ],
      "settings": {
        "headless": true,
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "budget": {
          "resourceSizes": [
            { "resourceType": "total", "budget": 300 },
            { "resourceType": "script", "budget": 120 },
            { "resourceType": "css", "budget": 40 },
            { "resourceType": "image", "budget": 80 },
            { "resourceType": "font", "budget": 30 },
            { "resourceType": "third-party", "budget": 50 }
          ],
          "resourceCounts": [
            { "resourceType": "third-party", "budget": 15 }
          ]
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.8 }],
        "categories:pwa": ["off"],
        "first-contentful-paint": ["warn", { "maxNumericValue": 3000 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 3500 }],
        "interactive": ["warn", { "maxNumericValue": 4500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 400 }],
        "max-potential-fid": ["warn", { "maxNumericValue": 400 }],
        "render-blocking-resources": ["warn", { "maxNumericValue": 600 }],
        "unused-javascript": ["warn", { "maxNumericValue": 500 }],
        "uses-rel-preload": ["warn"],
        "uses-text-compression": ["warn"]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
