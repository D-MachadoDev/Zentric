{
  "name": "@zentric/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Design system Zentric: tokens (Q7/Q8), logo (Q6) y shadcn/ui adaptado (Q5/Q14).",
  "exports": {
    ".": "./src/index.ts",
    "./styles/theme.css": "./src/styles/theme.css",
    "./tokens": "./src/tokens/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./lib": "./src/lib/index.ts",
    "./lib/cn": "./src/lib/cn.ts",
    "./hooks": "./src/hooks/index.ts",
    "./logo": "./src/logo/index.ts",
    "./composite": "./src/composite/index.ts",
    "./components/ui/*": "./src/components/ui/*.tsx"
  },
  "//": "Sin build: la app importa el TS fuente via Vite y el empaquetado lo resuelve el bundler. Emitir declaraciones solo añadiria un paso que nadie consume.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "radix-ui": "1.7.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@zentric/config": "workspace:*",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
